<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window paints the sky colour before Compose draws, so there is no white flash on start. -->
    <style name="Theme.Trollvik" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/sky</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
